diff --git a/scripts/player.gd b/scripts/player.gd
index 0228da3..3fba75b 100644
--- a/scripts/player.gd
+++ b/scripts/player.gd
@@ -28,7 +28,8 @@ var aim := Vector2.RIGHT
 var move_mult := 1.0
 var stun_until := 0.0
 
-var cd := {1: 0.0, 2: 0.0}
+var cd := {1: 0.0, 2: 0.0}          # seconds left on skill 1 / 2 (server is the source of truth)
+var cd_max := {1: 1.0, 2: 1.0}      # length of the cooldown that is currently running (for the HUD circles)
 var atk_cd := 0.0
 var next_crits := 0
 var attack_count := 0
@@ -124,6 +125,9 @@ func _physics_process(delta: float) -> void:
 		_local_input(delta)
 	if multiplayer.is_server():
 		_server_tick(delta)
+	else:
+		cd[1] = maxf(0.0, cd[1] - delta)       # client mirror of the server's cooldowns (HUD only)
+		cd[2] = maxf(0.0, cd[2] - delta)
 	for f in _fx:
 		f.t -= delta
 	_fx = _fx.filter(func(f): return f.t > 0.0)
@@ -155,6 +159,37 @@ func _to_server(method: StringName, args: Array) -> void:
 		callv("rpc_id", [1, method] + args)
 
 
+## SERVER: start (or replace) a skill cooldown and tell the owning player so the HUD circle follows it.
+func start_cd(slot: int, secs: float) -> void:
+	cd[slot] = secs
+	cd_max[slot] = maxf(secs, 0.01)
+	_push_cd()
+
+
+func _push_cd() -> void:
+	if is_bot:
+		return
+	if peer_id == multiplayer.get_unique_id():
+		net_cd(cd[1], cd[2], cd_max[1], cd_max[2])          # host's own player: no network hop
+	else:
+		rpc_id(peer_id, "net_cd", cd[1], cd[2], cd_max[1], cd_max[2])
+
+
+@rpc("any_peer", "call_local", "reliable")
+func net_cd(left1: float, left2: float, max1: float, max2: float) -> void:
+	if not _from_server():
+		return
+	cd = {1: left1, 2: left2}
+	cd_max = {1: max1, 2: max2}
+
+
+## 0.0 = just used, 1.0 = ready again (what the HUD circles show).
+func cd_fill(slot: int) -> float:
+	if cd[slot] <= 0.0:
+		return 1.0
+	return clampf(1.0 - cd[slot] / cd_max[slot], 0.0, 1.0)
+
+
 func _server_tick(delta: float) -> void:
 	_item_tick(delta)
 	atk_cd = maxf(0.0, atk_cd - delta)
@@ -231,6 +266,7 @@ func server_damage(amount: float, _source: Node = null) -> void:
 		_mitt_icd = _now() + 1.0
 		cd[1] = maxf(0.0, cd[1] - 0.5)
 		cd[2] = maxf(0.0, cd[2] - 0.5)
+		_push_cd()
 	if shield > 0.0:
 		var absorbed := minf(shield, amount)
 		shield -= absorbed
diff --git a/scripts/skill_cooldown_hud.gd b/scripts/skill_cooldown_hud.gd
new file mode 100644
index 0000000..63b3b1e
--- /dev/null
+++ b/scripts/skill_cooldown_hud.gd
@@ -0,0 +1,60 @@
+class_name SkillCooldownHUD
+extends Control
+## Two circles at the bottom-centre of the screen, one per skill ([Q] and [E]).
+## Each circle fills clockwise from the top as the cooldown runs; when it is full the
+## skill is ready (bright ring + key letter). While cooling down it shows the seconds left.
+
+const RADIUS := 34.0
+const SPACING := 150.0
+const BOTTOM_MARGIN := 62.0
+const KEYS := {1: "Q", 2: "E"}
+const COL_BG := Color(0.08, 0.08, 0.10, 0.75)
+const COL_FILL := Color(0.30, 0.65, 1.00, 0.85)
+const COL_READY := Color(0.35, 0.90, 0.45, 1.0)
+
+var mm: MatchManager
+
+
+func setup(match_manager: MatchManager) -> void:
+	mm = match_manager
+	set_anchors_preset(Control.PRESET_FULL_RECT)
+	mouse_filter = Control.MOUSE_FILTER_IGNORE
+
+
+func _process(_d: float) -> void:
+	queue_redraw()
+
+
+func _draw() -> void:
+	var me := mm.local_player() if mm != null else null
+	if me == null:
+		return
+	var def: Dictionary = GameData.CHARACTERS[me.char_id]
+	var font := ThemeDB.fallback_font
+	var mid := Vector2(size.x * 0.5, size.y - BOTTOM_MARGIN)
+	for slot in [1, 2]:
+		var c := mid + Vector2((slot - 1.5) * SPACING, 0.0)
+		var fill: float = me.cd_fill(slot)
+		var ready: bool = me.cd[slot] <= 0.0
+		draw_circle(c, RADIUS, COL_BG)
+		if ready:
+			draw_circle(c, RADIUS - 3.0, Color(COL_READY, 0.35))
+		elif fill > 0.0:
+			draw_colored_polygon(_pie(c, RADIUS - 3.0, fill), COL_FILL)
+		draw_arc(c, RADIUS, 0.0, TAU, 48, COL_READY if ready else Color(1, 1, 1, 0.55), 3.0, true)
+		var label: String = KEYS[slot] if ready else "%.1f" % float(me.cd[slot])
+		draw_string(font, c + Vector2(-RADIUS, 8.0), label, HORIZONTAL_ALIGNMENT_CENTER, RADIUS * 2.0, 22, Color.WHITE)
+		var sname: String = def["skill%d" % slot].name
+		draw_string(font, c + Vector2(-75.0, RADIUS + 18.0), sname, HORIZONTAL_ALIGNMENT_CENTER, 150.0, 12, Color(1, 1, 1, 0.85))
+		if not ready:
+			draw_string(font, c + Vector2(-RADIUS, -RADIUS - 6.0), KEYS[slot], HORIZONTAL_ALIGNMENT_CENTER, RADIUS * 2.0, 13, Color(1, 1, 1, 0.7))
+
+
+## Filled wedge starting at 12 o'clock going clockwise; fraction 0..1.
+static func _pie(center: Vector2, r: float, fraction: float) -> PackedVector2Array:
+	var pts := PackedVector2Array([center])
+	var steps := maxi(2, int(48.0 * fraction))
+	for i in steps + 1:
+		var a := -PI * 0.5 + TAU * fraction * float(i) / float(steps)
+		pts.append(center + Vector2(cos(a), sin(a)) * r)
+	return pts

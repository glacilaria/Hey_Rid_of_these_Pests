 scripts/player.gd                 | 38 +++++++++++++++++++-
 scripts/skill_cooldown_hud.gd     | 60 +++++++++++++++++++++++++++++++
 scripts/skill_cooldown_hud.gd.uid |  1 +
 scripts/skills.gd                 |  4 +--
 5 files changed, 103 insertions(+), 3 deletions(-)
 create mode 100644 scripts/skill_cooldown_hud.gd
 create mode 100644 scripts/skill_cooldown_hud.gd.uid

